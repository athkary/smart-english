# Copy to .env for local runs (never commit .env). All provider keys stay on the server.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://smart:smart@localhost:5432/smart_english
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
# Comma-separated origins allowed to call the API (the web app's address)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional until Phase 4
REDIS_URL=
# Phase 3+
ANTHROPIC_API_KEY=
